{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lunacy-continuation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","runRoot","runId","phaseId","planDigest","policyDigest","rootIdentity","owner","ownerNonce","ownerPid","leaseEpoch","leaseExpiresAt","deadline","maxWakes","wakeCount","wakeInFlight","wakeSources","generation","currentGeneration","currentRevision","currentAuthorityEpoch","currentAttemptEpoch","currentBarrierEpoch","revocationGeneration","state","attention","lastWakeSource","lastWakeAt"],
  "properties": {
    "schema": {"const":"lunacy-continuation/v1"}, "version":{"const":1},
    "runRoot":{"type":"string","pattern":"^/"}, "runId":{"type":"string","minLength":1}, "phaseId":{"type":"string","minLength":1},
    "planDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}, "policyDigest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "rootIdentity":{"type":"object","additionalProperties":false,"required":["dev","ino"],"properties":{"dev":{"type":"string","minLength":1,"maxLength":100},"ino":{"type":"string","minLength":1,"maxLength":100}}},
    "owner":{"type":"string","minLength":1}, "ownerNonce":{"type":"string","minLength":1}, "ownerPid":{"type":"integer","minimum":1}, "leaseEpoch":{"type":"integer","minimum":1},
    "leaseExpiresAt":{"type":"string","format":"date-time"}, "deadline":{"type":"string","format":"date-time"}, "maxWakes":{"type":"integer","minimum":1,"maximum":1024}, "wakeCount":{"type":"integer","minimum":0}, "wakeInFlight":{"type":"boolean"},
    "wakeSources":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["explicit-resume","proof"]}},
    "generation":{"type":"integer","minimum":1}, "currentGeneration":{"type":"integer","minimum":1}, "currentRevision":{"type":"integer","minimum":0}, "currentAuthorityEpoch":{"type":"integer","minimum":0}, "currentAttemptEpoch":{"type":"integer","minimum":0}, "currentBarrierEpoch":{"type":"integer","minimum":0}, "revocationGeneration":{"type":"integer","minimum":0},
    "state":{"enum":["ACTIVE","ATTENTION","REVOKED","CLOSED"]}, "attention":{"type":["string","null"],"enum":["MALFORMED","MALFORMED_PROOF","DISABLED","CURRENT_INVALID","BINDING_DRIFT","LEASE_LOST","STALE_LIVENESS","LEASE_EXPIRED","REVOKED","MAX_WAKES","DEADLINE_EXPIRED","CANCELLED","UNKNOWN","UNSUPPORTED_WAKE","UNSUPPORTED_BOUNDARY","SIDECAR_CONFLICT","SIDECAR_FAULT","LIFECYCLE_ERROR",null]}, "lastWakeSource":{"type":["string","null"],"enum":["explicit-resume","proof",null]}, "lastWakeAt":{"type":["string","null"],"format":"date-time"}
  }
}
