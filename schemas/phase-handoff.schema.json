{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lunacy-phase-handoff/v1",
  "title": "Digest-bound exact phase handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "predecessor", "successor", "authorization", "authorizationDigest"],
  "properties": {
    "schema": {"const": "lunacy-phase-handoff/v1"}, "version": {"const": 1},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["runRoot", "runId", "phaseId", "generation", "revision", "planDigest", "proofDigest"], "properties": {"runRoot": {"type": "string"}, "runId": {"type": "string"}, "phaseId": {"type": "string"}, "generation": {"type": "integer", "minimum": 0}, "revision": {"type": "integer", "minimum": 0}, "planDigest": {"$ref": "#/$defs/digest"}, "proofDigest": {"$ref": "#/$defs/digest"}}},
    "successor": {"type": "object", "additionalProperties": false, "required": ["runRoot", "runId", "phaseId", "plan", "planDigest"], "properties": {"runRoot": {"type": "string"}, "runId": {"type": "string"}, "phaseId": {"type": "string"}, "plan": {"type": "object"}, "planDigest": {"$ref": "#/$defs/digest"}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["kind", "predecessorRunId", "predecessorPhaseId", "successorRunId", "successorPhaseId", "successorPlanDigest", "eventId"], "properties": {"kind": {"const": "PROMOTE_PHASE"}, "predecessorRunId": {"type": "string"}, "predecessorPhaseId": {"type": "string"}, "successorRunId": {"type": "string"}, "successorPhaseId": {"type": "string"}, "successorPlanDigest": {"$ref": "#/$defs/digest"}, "eventId": {"type": "string"}}},
    "authorizationDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
